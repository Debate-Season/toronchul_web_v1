# ── REST API ──────────────────────────────────────
# 서버 사이드 전용 (rewrites 프록시 대상)
API_BASE_URL=https://api.toronchul.app/prod
# 레거시 (클라이언트에서는 /proxy rewrites로 우회)
NEXT_PUBLIC_API_URL=https://api.toronchul.app/prod

# ── WebSocket ─────────────────────────────────────
NEXT_PUBLIC_WS_URL=wss://api.toronchul.app/prod/ws-stomp

# ── Image CDN ─────────────────────────────────────
NEXT_PUBLIC_IMAGE_URL=https://api.toronchul.app/images/

# ── Kakao OAuth ───────────────────────────────────
# CLIENT_ID 는 반드시 카카오 "REST API 키" (네이티브/JS 키 아님).
NEXT_PUBLIC_KAKAO_CLIENT_ID=your_kakao_rest_api_key
# 로컬: http://localhost:3000/oauth/callback/kakao
# 배포(Vercel): https://toronchul.app/oauth/callback/kakao
# 두 URI 모두 카카오 콘솔의 Redirect URI 에 등록되어 있어야 함.
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/oauth/callback/kakao

# ── Apple OAuth ───────────────────────────────────
# Service ID (Apple Developer > Identifiers > Services IDs).
NEXT_PUBLIC_APPLE_CLIENT_ID=com.rosyocean.debateseason.web
# response_mode=form_post 이므로 Apple 은 이 URI 로 POST 를 보낸다.
# → POST 를 받는 route handler(/api/auth/apple/callback)여야 하며,
#   클라이언트 페이지(/oauth/callback/apple)를 넣으면 안 됨.
# 로컬: http://localhost:3000/api/auth/apple/callback
# 배포(Vercel): https://toronchul.app/api/auth/apple/callback
# 위 도메인/URI 는 Apple Service ID 의 Domains & Return URLs 에 등록되어 있어야 함.
NEXT_PUBLIC_APPLE_REDIRECT_URI=http://localhost:3000/api/auth/apple/callback

# ── Amplitude Analytics ───────────────────────────
NEXT_PUBLIC_AMPLITUDE_API_KEY=your_amplitude_api_key

# ── PostHog (v0.8.0) ──────────────────────────────
# 키가 없으면 계측 전체가 조용히 no-op 이다. 로컬에서 끄려면 비워두면 된다.
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog 앱 링크(툴바 등)가 가리킬 호스트. EU 계정이면 https://eu.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
# 리버스 프록시(/relay) 목적지 리전. us | eu — 서버에서만 쓰인다.
POSTHOG_REGION=us

# ── Site ──────────────────────────────────────────
# metadataBase (og:image 절대 URL 생성용). 미설정 시 https://toronchul.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
